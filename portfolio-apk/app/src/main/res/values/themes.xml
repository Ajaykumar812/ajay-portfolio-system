<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen theme - full screen dark with no action bar -->
    <style name="Theme.Splash" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Main app theme -->
    <style name="Theme.PortfolioManagementSystem" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.PortfolioManagementSystem.NoActionBar" parent="Theme.PortfolioManagementSystem" />
</resources>